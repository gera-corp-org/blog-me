<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= it.pageTitle %></title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="alternate" type="application/atom+xml" title="<%= it.site.title %>" href="/feed.xml">
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/"><span class="prompt-host">gera@blog</span>:<span class="prompt-path">~/записки</span>$<span class="cursor" aria-hidden="true"></span></a>
      <nav class="site-nav">
        <a href="/">Записи</a>
        <a href="/about">Обо мне</a>
        <form class="search-form" action="/search" method="get" role="search">
          <input type="search" name="q" value="<%= it.q %>" placeholder="Поиск" aria-label="Поиск по записям">
        </form>
        <% if (it.user) { %>
          <a href="/admin">Записи</a>
          <form method="post" action="/admin/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= it.csrf %>">
            <button type="submit" class="link-button">Выйти</button>
          </form>
        <% } %>
      </nav>
    </header>
    <main>
